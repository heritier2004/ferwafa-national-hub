{
  "name": "sportexa",
  "productName": "Sportexa",
  "version": "1.0.0",
  "description": "Football Intelligence & Talent Management Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "Sportexa Team",
  "license": "ISC",
  "build": {
    "appId": "com.sportexa.desktop",
    "productName": "Sportexa",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "frontend/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt",
      "shortcutName": "Sportexa"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Sports"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/",
        "to": "dist/",
        "filter": [
          "**/*"
        ]
      },
      "frontend/**/*",
      "START_FULL_SYSTEM.bat",
      ".env",
      "assets/models/yolov8n.pt",
      "database/**/*",
      "football_intelligence.db"
    ]
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
